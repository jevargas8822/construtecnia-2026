# ==============================================================================
# CONSTRUCTECNIA 2026 - VARIABLES DE ENTORNO REQUERIDAS
# Copia este archivo como .env.local para desarrollo local
# En Vercel: Configura estas variables en Settings -> Environment Variables
# ==============================================================================

# Cadena de conexión a PostgreSQL (Neon pooled, Supabase o Vercel Postgres)
# Formato Neon Pooler: postgresql://[usuario]:[password]@[host-pooler]:[puerto]/[basededatos]?sslmode=require
DATABASE_URL="postgresql://neondb_owner:contraseña@ep-cool-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Contraseña de acceso exclusiva del Staff para el panel /admin
# IMPORTANTE: Definir únicamente aquí y en Vercel. Nunca escribir en código fuente.
ADMIN_PASSWORD="tu_contraseña_segura_de_staff"

# Sal secreta para el hash SHA-256 de las direcciones IP (opcional, tiene valor por defecto)
IP_SALT="constructecnia-adeic-pucp-2026-salt"
